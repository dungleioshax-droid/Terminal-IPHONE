#!/bin/sh
# Terminal-IPHONE claude-auth — authenticate Claude Code on the device.
#
# Methods:
#   1) ANTHROPIC_API_KEY  (direct API billing)
#   2) Max/Pro OAuth      (subscription; PKCE flow, local callback server
#                          on 127.0.0.1:19283 — opens the URL in Safari)
#   3) Status
r=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." 2>/dev/null && pwd -P) || r=""
NODE="$r/usr/local/bin/node"
CONFIG_DIR="${HOME:-/var/mobile}/.claude"
mkdir -p "$CONFIG_DIR" 2>/dev/null || CONFIG_DIR="/var/mobile/.claude"
mkdir -p "$CONFIG_DIR" 2>/dev/null

echo ""
echo "=========================================="
echo "   Claude Code — authentication (iOS)"
echo "=========================================="
echo ""
echo "  1) API key  (console.anthropic.com, direct billing)"
echo "  2) Claude Max / Pro plan (OAuth in Safari)"
echo "  3) Status"
echo ""
printf "Choice [1-3]: "
read choice 2>/dev/null || choice=${1:-3}
case "$choice" in
	1)
		printf "Paste your API key (sk-ant-...): "
		read api_key
		case "$api_key" in
			sk-ant-*) ;;
			*)
				echo "That does not look like an Anthropic API key."
				exit 1
				;;
		esac
		printf 'export ANTHROPIC_API_KEY="%s"\n' "$api_key" \
			> "$CONFIG_DIR/credentials"
		chmod 600 "$CONFIG_DIR/credentials" 2>/dev/null
		printf '{\n  "apiKey": "%s"\n}\n' "$api_key" \
			> "$CONFIG_DIR/.credentials.json"
		chmod 600 "$CONFIG_DIR/.credentials.json" 2>/dev/null
		echo "Saved. Run:  claude"
		;;
	2)
		AUTH_JS="$CONFIG_DIR/oauth-helper.js"
		cat > "$AUTH_JS" << 'OAUTHHELPER'
const http = require('http');
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');

const OAUTH_AUTHORIZE_URL = 'https://claude.ai/oauth/authorize';
const OAUTH_TOKEN_URL = 'https://console.anthropic.com/v1/oauth/token';
const CLIENT_ID = '9d1c250a-e61b-44d9-88ed-5944d1962f5e';
const REDIRECT_URI = 'http://127.0.0.1:19283/callback';
const SCOPES = 'org:create_api_key user:profile user:inference';
const PORT = 19283;
const CONFIG_DIR = process.env.CLAUDE_CONFIG_DIR ||
	path.join(process.env.HOME || os.homedir(), '.claude');

const state = crypto.randomBytes(16).toString('hex');
const codeVerifier = crypto.randomBytes(32).toString('base64url');
const codeChallenge = crypto
	.createHash('sha256')
	.update(codeVerifier)
	.digest('base64url');

const params = new URLSearchParams({
	code: 'true',
	client_id: CLIENT_ID,
	response_type: 'code',
	redirect_uri: REDIRECT_URI,
	scope: SCOPES,
	code_challenge: codeChallenge,
	code_challenge_method: 'S256',
	state: state,
});
const authUrl = `${OAUTH_AUTHORIZE_URL}?${params.toString()}`;

async function exchange(code) {
	const response = await fetch(OAUTH_TOKEN_URL, {
		method: 'POST',
		headers: {
			'Content-Type': 'application/json',
			'User-Agent': 'Terminal-IPHONE/3.0',
			Accept: 'application/json',
		},
		body: JSON.stringify({
			grant_type: 'authorization_code',
			client_id: CLIENT_ID,
			code: code,
			redirect_uri: REDIRECT_URI,
			code_verifier: codeVerifier,
			state: state,
		}),
	});
	if (!response.ok) {
		throw new Error(
			'token exchange failed: ' + response.status + ' ' + (await response.text()),
		);
	}
	return response.json();
}

function save(oauth) {
	const file = path.join(CONFIG_DIR, '.credentials.json');
	const payload = {
		claudeAiOauth: {
			access_token: oauth.access_token,
			refresh_token: oauth.refresh_token,
			apiKey: oauth.apiKey,
			expires_at: oauth.expires_in
				? Date.now() + oauth.expires_in * 1000
				: undefined,
			scopes: SCOPES.split(' '),
		},
	};
	fs.writeFileSync(file, JSON.stringify(payload, null, 2));
	fs.writeFileSync(path.join(CONFIG_DIR, 'credentials'), 'export ANTHROPIC_API_KEY=""\n');
	fs.chmodSync(file, 0o600);
	console.log('');
	console.log('OAuth session saved to ' + file);
	console.log('You can now run:  claude');
}

const server = http.createServer(async (req, res) => {
	const url = new URL(req.url, 'http://127.0.0.1:' + PORT);
	if (url.pathname !== '/callback') {
		res.writeHead(404).end();
		return;
	}
	const code = url.searchParams.get('code');
	const error = url.searchParams.get('error');
	const returnedState = url.searchParams.get('state');
	const page = (title, body) =>
		res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' })
			.end(
				'<html><body style="font-family:system-ui;padding:40px;text-align:center">' +
				'<h1>' + title + '</h1><p>' + body + '</p></body></html>',
			);
	try {
		if (error) throw new Error('provider returned: ' + error);
		if (returnedState !== state) throw new Error('state mismatch (CSRF?)');
		const oauth = await exchange(code);
		save(oauth);
		page('✔ Claude Code authenticated', 'You can close Safari and return to the Terminal.');
		setTimeout(() => process.exit(0), 500);
	} catch (e) {
		console.error('OAuth failed: ' + e.message);
		page('✘ Authentication failed', e.message + '. You can close this window.');
		setTimeout(() => process.exit(1), 500);
	}
});
server.listen(PORT, '127.0.0.1', () => {
	console.log('');
	console.log('Opening this link in Safari to authorize:');
	console.log('');
	console.log(authUrl);
	console.log('');
	console.log('(Safari redirects back to 127.0.0.1:' + PORT + ' on this device.)');
});
server.on('error', (e) => {
	console.error('Cannot start the callback server: ' + e.message);
	process.exit(1);
});
OAUTHHELPER
		export CLAUDE_CONFIG_DIR="$CONFIG_DIR"
		export HOME="${HOME:-/var/mobile}"
		"$NODE" "$AUTH_JS"
		;;
	*)
		echo ""
		if [ -f "$CONFIG_DIR/.credentials.json" ]; then
			if grep -q claudeAiOauth "$CONFIG_DIR/.credentials.json" 2>/dev/null; then
				echo "Authenticated: Claude Max/Pro (OAuth)."
			elif grep -q apiKey "$CONFIG_DIR/.credentials.json" 2>/dev/null; then
				echo "Authenticated: API key."
			else
				echo "Credentials file exists but is not recognizable."
			fi
		else
			echo "Not authenticated. Run:  claude-auth"
		fi
		;;
esac
