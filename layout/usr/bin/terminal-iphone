#!/bin/sh
# Terminal-IPHONE — AI environment launcher.
#
#   terminal-iphone              -> aienv bootstrap (walks the doctor/fix path)
#   terminal-iphone doctor      -> aienv doctor
#   terminal-iphone install-claude [version]
#
# Delegates to aienv; kept for backwards compatibility with 2.x docs.
d=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || exit 1
ROOT=$(CDPATH= cd -- "$d/../.." 2>/dev/null && pwd -P) || exit 1
AIENV="$ROOT/usr/local/bin/aienv"
if [ -x "$AIENV" ]; then
	exec "$AIENV" "$@"
fi
if [ -f "$ROOT/usr/share/terminal-iphone/bootstrap-iphone.sh" ]; then
	exec sh "$ROOT/usr/share/terminal-iphone/bootstrap-iphone.sh" "$@"
fi
echo "terminal-iphone: aienv not found — reinstall terminal-iphone-app-roothide" >&2
exit 1
