#!/bin/sh
# Runs after install/upgrade. Registers the SpringBoard icon, re-signs the
# embedded Node.js runtime (JIT entitlements) and kicks off the AI
# environment bootstrap (aienv) in the background. Every jailbreak path is
# resolved at runtime so the same package works rootful ("" root), rootless
# (/var/jb) and RootHide (randomized root).
set -u

# Derive the jailbreak root from a tool that lives in <root>/usr/bin.
pkg_root() {
	for tool in apt-get uicache dpkg; do
		p=$(command -v "$tool" 2>/dev/null) || continue
		[ -n "$p" ] || continue
		d=$(dirname "$p")
		[ "$(basename "$d")" = "bin" ] || continue
		# Rootful legacy layout: /usr/bin/x lives directly on the system root.
		if [ "$(dirname "$d")" = "/" ]; then
			echo ""
			return 0
		fi
		[ "$(basename "$(dirname "$d")")" = "usr" ] || continue
		(CDPATH= cd -- "$d/../.." 2>/dev/null && pwd -P) && return 0
	done
	# Last resort: classic rootless prefix.
	if [ -x /var/jb/usr/bin/uicache ]; then
		echo "/var/jb"
		return 0
	fi
	echo ""
}

ROOT=$(pkg_root)
APP="${ROOT}/Applications/TerminalIPHONE.app"
SHARE="${ROOT}/usr/share/terminal-iphone"
UICACHE="${ROOT}/usr/bin/uicache"
NODEHOST="${ROOT}/usr/local/lib/nodejs/node"
NODEENTS="${ROOT}/usr/local/lib/nodejs/entitlements.xml"

# 1. Register the app icon with SpringBoard.
if [ -d "$APP" ]; then
	if [ -x "$UICACHE" ]; then
		"$UICACHE" -p "$APP" >/dev/null 2>&1 || true
	elif command -v uicache >/dev/null 2>&1; then
		uicache -p "$APP" >/dev/null 2>&1
	fi
fi

# 2. Make the AI/runtime helpers executable and re-sign the Node.js binary
#    with the JIT entitlements shipped inside the package (needs ldid; it is
#    part of the Procursus/roothide bootstrap, and missing it is logged by
#    `aienv doctor` as a warning rather than a hard failure).
chmod 755 "${ROOT}/usr/local/bin/node" \
	"${ROOT}/usr/local/bin/npm" \
	"${ROOT}/usr/local/bin/npx" \
	"${ROOT}/usr/local/bin/aienv" \
	"${ROOT}/usr/local/bin/claude-auth" \
	"${ROOT}/usr/bin/terminal-iphone" 2>/dev/null || true
if [ -x "$NODEHOST" ] && [ -f "$NODEENTS" ]; then
	LDID="${ROOT}/usr/bin/ldid"
	[ -x "$LDID" ] || LDID=$(command -v ldid 2>/dev/null || true)
	if [ -n "${LDID:-}" ]; then
		"$LDID" -S"$NODEENTS" "$NODEHOST" >/dev/null 2>&1 || true
	fi
fi

# 3. Bootstrap the AI environment (Node check, npm sanity, claude-code
#    install) in the background — log kept at a fixed system path.
BOOT="$SHARE/bootstrap-iphone.sh"
if [ -f "$BOOT" ]; then
	mkdir -p /var/mobile/terminal-iphone 2>/dev/null || true
	LOG=/var/mobile/terminal-iphone/aienv.log
	if [ -x /usr/bin/nohup ]; then
		AIENV_LOG="$LOG" /usr/bin/nohup /bin/sh "$BOOT" >>"$LOG" 2>&1 &
	else
		AIENV_LOG="$LOG" /bin/sh "$BOOT" >>"$LOG" 2>&1 &
	fi
fi

exit 0
