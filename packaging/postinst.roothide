#!/bin/sh
set -e
mkdir -p /var/jb/etc/apt/sources.list.d /var/jb/var/mobile/terminal-iphone 2>/dev/null || true
echo "deb http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse" > /var/jb/etc/apt/sources.list.d/terminal-iphone.list 2>/dev/null || true
if [ -x /var/jb/opt/terminal-iphone/scripts/bootstrap-iphone.sh ]; then
  nohup /var/jb/opt/terminal-iphone/scripts/bootstrap-iphone.sh >/var/jb/var/mobile/terminal-iphone/bootstrap.log 2>&1 &
fi
if [ -f /var/jb/opt/terminal-iphone/Terminal.mobileconfig ]; then
  cp /var/jb/opt/terminal-iphone/Terminal.mobileconfig /var/jb/var/mobile/terminal-iphone/Terminal.mobileconfig 2>/dev/null || true
fi
/var/jb/usr/bin/uicache -p /var/jb/Applications/TerminalIPHONE.app 2>/dev/null || true
exit 0