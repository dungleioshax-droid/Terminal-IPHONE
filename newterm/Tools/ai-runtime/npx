#!/bin/sh
# NewTerm 3 AI — npx, runs npx-cli.js from the staged npm 10.8.2 runtime.
r=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." 2>/dev/null && pwd -P) || r=""
NODE="$r/usr/local/bin/node"
NPXCLI="$r/usr/local/lib/node_modules/npm/bin/npx-cli.js"
if [ ! -f "$NPXCLI" ]; then
	echo "aienv: npx is not installed at $NPXCLI." >&2
	echo "aienv: run 'aienv fix-node' (or reinstall the NewTerm 3 AI package)." >&2
	exit 127
fi
export NPM_CONFIG_PREFIX="$r/usr/local"
export npm_config_prefix="$r/usr/local"
export HOME="${HOME:-/var/mobile}"
exec "$NODE" "$NPXCLI" "$@"
