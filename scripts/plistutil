#!/usr/bin/env python3
"""Minimal drop-in for libplist's `plistutil`.

Only the flags used by Theos' convert_xml_plist.sh are supported:

    plistutil -i INPUT -f bin|xml -o OUTPUT

Built with Python's plistlib so the build does not depend on system
libplist packages (the toolchain bundles a plistutil that links
libplist-2.0.so.4, which is absent on many runners).
"""
import argparse
import plistlib
import sys


def load(path):
    with open(path, "rb") as handle:
        return plistlib.load(handle)


def main(argv):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-i", dest="input", required=True)
    parser.add_argument("-f", dest="fmt", default="bin")
    parser.add_argument("-o", dest="output", required=True)
    args, unknown = parser.parse_known_args(argv)
    if unknown:
        sys.stderr.write("plistutil: unsupported arguments: %s\n" % " ".join(unknown))
        return 2

    data = load(args.input)          # read fully before truncating the file
    fmt = plistlib.FMT_XML if args.fmt.lower().startswith("xml") else plistlib.FMT_BINARY
    with open(args.output, "wb") as handle:
        plistlib.dump(data, handle, fmt=fmt)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))